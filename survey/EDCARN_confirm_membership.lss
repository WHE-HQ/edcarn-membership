   <row>
    <id><![CDATA[9002]]></id>
    <qid><![CDATA[1001]]></qid>
    <question><![CDATA[<p>Dear {TOKEN:FIRSTNAME},</p><p>These are the details EDCARN currently holds for you:</p><table><tbody><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Name</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{TOKEN:FIRSTNAME} {TOKEN:LASTNAME}</strong></td></tr><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Email</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{TOKEN:EMAIL}</strong></td></tr><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Organisation</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{if(is_empty(TOKEN:ATTRIBUTE_1), "not on file", TOKEN:ATTRIBUTE_1)}</strong></td></tr><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Specialization / unit</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{if(is_empty(TOKEN:ATTRIBUTE_2), "not on file", TOKEN:ATTRIBUTE_2)}</strong></td></tr><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Country</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{if(is_empty(TOKEN:ATTRIBUTE_3), "not on file", TOKEN:ATTRIBUTE_3)}</strong></td></tr><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Sex</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{if(is_empty(TOKEN:ATTRIBUTE_5), "not on file", TOKEN:ATTRIBUTE_5)}</strong></td></tr><tr><td style="padding:4px 14px 4px 0;vertical-align:top;">Working language(s)</td><td style="padding:4px 14px 4px 0;vertical-align:top;"><strong>{if(is_empty(TOKEN:ATTRIBUTE_6), "not specified", TOKEN:ATTRIBUTE_6)}</strong></td></tr></tbody></table>]]></question>
